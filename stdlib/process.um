// The process: its arguments, its environment, and the way it ends.
//
// There is no hidden global holding the arguments. C hands them to `main`, so a
// program that wants them says so in its signature:
//
//     fn main(argc: i32, argv: *mut *mut u8) -> i32 {
//         let args = Args::new(argc, argv)
//         ...
//     }
//
// Keeping them out of a global means an `Args` can be copied, passed to a
// function and dropped like any other value, and that nothing in the runtime
// depends on `main` having been written a particular way.

// The argument vector, and the program name that is its first entry.
struct Args {
    argc: i32,
    argv: *mut *mut u8,
}

impl Args {
    fn new(argc: i32, argv: *mut *mut u8) -> Args {
        return Args { argc: argc, argv: argv }
    }

    // How many arguments there are, including the program's own name.
    fn len(&self) -> i32 {
        return self.argc
    }

    // True when the program was given no arguments beyond its name.
    fn is_empty(&self) -> bool {
        return self.argc <= 1
    }

    // The program's own name, which is the first argument.
    fn program(&self) -> *const u8 {
        return self.get(0)
    }

    // Argument `index`, or a pointer to an empty string when there is no such
    // argument. Returning null would make every caller check before printing.
    fn get(&self, index: i32) -> *const u8 {
        if index < 0 || index >= self.argc {
            return "" as *const u8
        }
        return arg_at(self.argv, index)
    }

    // True when `name` appears among the arguments.
    fn has_flag(&self, name: *const u8) -> bool {
        let mut i = 1
        while i < self.argc {
            if bytes_equal(self.get(i), name) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // The argument after `name`, or an empty string when `name` is absent or last.
    fn value_after(&self, name: *const u8) -> *const u8 {
        let mut i = 1
        while i < self.argc {
            if bytes_equal(self.get(i), name) {
                return self.get(i + 1)
            }
            i = i + 1
        }
        return "" as *const u8
    }
}

// The `index`th entry of an argument vector.
//
// This is raw pointer arithmetic, so it is spelled out once here rather than at
// every call site.
fn arg_at(argv: *mut *mut u8, index: i32) -> *const u8 {
    unsafe {
        let slot = (argv as usize + (index as usize) * 8) as *const *mut u8
        return *slot
    }
}

// True when a pointer is the null pointer.
fn is_null(p: *const u8) -> bool {
    unsafe {
        return p as usize == 0
    }
}

// Byte `index` of a NUL-terminated string.
fn byte_at(text: *const u8, index: i32) -> u8 {
    unsafe {
        return read_byte((text as usize + index as usize) as *const u8)
    }
}

// True when two NUL-terminated byte strings are the same.
fn bytes_equal(a: *const u8, b: *const u8) -> bool {
    let mut i = 0
    while true {
        let x = byte_at(a, i)
        let y = byte_at(b, i)
        if x != y {
            return false
        }
        if x == 0u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// The value of an environment variable, or an empty string when it is not set.
fn env(name: *const u8) -> *const u8 {
    let value = umay_getenv(name)
    if is_null(value) {
        return "" as *const u8
    }
    return value
}

// True when an environment variable is set to something non-empty.
fn env_is_set(name: *const u8) -> bool {
    return read_byte(env(name)) != 0u8
}

// Ends the process with `code`.
//
// This does not return, so a caller that reaches it needs no `return` after it;
// the trailing return is here only because the language has no divergence type.
fn exit(code: i32) {
    umay_exit(code)
}

// The number the last failing system call left in `errno`.
fn last_error() -> i32 {
    return umay_errno()
}
