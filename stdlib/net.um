// TCP sockets.
//
// The system calls are already reachable through `extern fn`; what this file adds
// is the boilerplate around them, which is where a server goes wrong. The socket
// address in particular: a port is two bytes in network order, and writing them
// the intuitive way binds the wrong port without any error.

// The seven bindings this file calls (`umay_net_socket`, `umay_net_bind`, ...)
// are not declared here. They are the one part of the library that differs
// between systems -- POSIX calls one set of names, Windows' Winsock another, and
// Windows also needs `WSAStartup` before the first call and a wider handle type
// -- so they live in `stdlib/platform/net_<system>.um` and the compiler puts the
// right file in front of this one.

// A listening or connected socket.
// A socket handle.
//
// `isize`, not `i32`: a POSIX descriptor is a small integer, but a Windows
// `SOCKET` is a 64-bit handle, and narrowing it to 32 bits loses the top half --
// the socket then refers to nothing and the first call through it faults.
// `isize` is wide enough for either and keeps "-1 means closed" working on both.
struct Socket {
    fd: isize,
}

// A socket address: an IPv4 address and a port, in the layout `bind` expects.
struct Address {
    bytes: *mut u8,
}

// Establishes a socket address for `port` on every interface.
//
// The two-byte family and the two-byte port are in network order, which is why
// the port's halves are swapped: writing it whole would bind a different port and
// still succeed.
fn address(port: u16) -> Address {
    let raw = alloc(16)
    unsafe {
        let mut i: usize = 0
        while i < 16 {
            write_byte((raw as usize + i) as *mut u8, 0u8)
            i = i + 1
        }
        // AF_INET is 2 on Linux, and the address field follows the port as zeroes,
        // which means "any interface".
        write_u16(raw, 2u16)
        write_u16((raw as usize + 2) as *mut u8, (port / 256u16) + (port % 256u16) * 256u16)
    }
    return Address { bytes: raw }
}

// How many bytes an `Address` occupies, as `bind` needs.
fn address_size() -> usize {
    return 16usize
}

// Releases an address.
fn release_address(a: Address) {
    dealloc(a.bytes)
}

// A closed socket, so a failure has a value to return.
fn closed_socket() -> Socket {
    return Socket { fd: -1isize }
}

// True when the socket is not open.
fn socket_is_closed(s: &Socket) -> bool {
    return s.fd < 0isize
}

// A TCP socket, or a closed one when the system would not give one.
fn tcp_socket() -> Socket {
    // A socket library that is not running returns nothing usable, and on
    // Windows nothing is usable before `WSAStartup` has succeeded.
    if !umay_platform_net_start() {
        return closed_socket()
    }
    // AF_INET is 2 and SOCK_STREAM is 1.
    let fd = umay_net_socket(2, 1, 0)
    if fd < 0isize {
        return closed_socket()
    }
    return Socket { fd: fd }
}

// Binds a socket to an address. Returns false when the address is taken.
//
// A held port is the usual reason, and it is not an error worth aborting on: a
// caller that has just restarted a server needs to report it and stop.
fn socket_bind(s: &Socket, a: &Address) -> bool {
    return umay_net_bind(s.fd, a.bytes as *const u8, address_size() as i32) == 0
}

// Enables SO_REUSEADDR on `s` before `socket_bind` (a no-op on Windows).
fn socket_set_reuseaddr(s: &Socket) -> bool {
    return umay_net_set_reuseaddr(s.fd)
}

// Starts listening on a bound socket. Returns false on failure.
fn socket_listen(s: &Socket, backlog: i32) -> bool {
    return umay_net_listen(s.fd, backlog) == 0
}

// Accepts one connection, returning a closed socket when that fails.
fn socket_accept(s: &Socket) -> Socket {
    let fd = umay_net_accept(s.fd, unsafe { 0 as *mut u8 }, unsafe { 0 as *mut i32 })
    if fd < 0isize {
        return closed_socket()
    }
    return Socket { fd: fd }
}

// Reads up to `into.len` bytes, returning how many arrived.
//
// Zero means the other end closed; a negative value is a failure. The caller is
// given the count rather than a terminator, so the bytes it reads are exactly the
// bytes that came.
fn socket_read(s: &Socket, into: *mut u8, capacity: usize) -> i64 {
    return umay_net_read(s.fd, into, capacity)
}

// Writes the whole of a buffer, retrying short writes.
//
// A single `write` may send less than it was given, so looping here is what makes
// "all the bytes are out" true for the caller.
fn socket_write_all(s: &Socket, data: *const u8, count: usize) -> bool {
    let mut sent: usize = 0
    while sent < count {
        let n = unsafe { umay_net_write(s.fd, (data as usize + sent) as *const u8, count - sent) }
        if n <= 0i64 {
            return false
        }
        sent = sent + n as usize
    }
    return true
}

// Sets how long a read may block before failing, in milliseconds; 0 clears it.
//
// A keep-alive connection has no request in flight most of the time. Without a
// timeout the child process holding it would live until the peer closed, so an
// idle connection is what this lets go.
fn socket_set_read_timeout(s: &Socket, millis: i32) -> bool {
    return umay_net_set_read_timeout(s.fd, millis)
}

// Disables Nagle's algorithm on a connected socket.
//
// A response is written as a head and then a body. With Nagle on, the second
// small write waits for the peer to acknowledge the first, and a peer that
// delays its acknowledgement turns every keep-alive response into a ~40 ms
// stall. Go's HTTP client and server both disable it; a server written here has
// to do the same.
fn socket_set_nodelay(s: &Socket) -> bool {
    return umay_net_set_nodelay(s.fd)
}

// Closes the socket. Doing it twice is harmless.
//
// Taking a reference rather than the socket keeps a caller free to close after
// its last use without the move being seen as ending the borrow order.
fn socket_close(s: &Socket) {
    if s.fd >= 0isize {
        umay_net_close(s.fd)
    }
}
