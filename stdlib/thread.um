// Threads, with `Send` checked at the one boundary a value crosses.
//
// The memory model is ownership and borrows, and both of those are statements about
// one thread. A value that moves into another thread escapes them, so the language
// says which types may do that: `Send`. A borrow shared with another thread is the
// other half of the question, and `Sync` is its name.

// A value that may be moved to another thread.
//
// This is a marker: it declares no methods, and a type that does not implement it
// cannot cross the boundary. That is the whole check, and it is made once, where
// the thread is created.
trait Send {}

// A value whose `&T` may be shared with another thread.
//
// Declared so that a scoped thread can be checked when it lands. Nothing reads it
// yet, and saying so is better than implying it is enforced.
trait Sync {}

impl Send for i64 {}
impl Send for usize {}
impl Send for i32 {}
impl Send for u32 {}
impl Send for u16 {}
impl Send for u8 {}
impl Send for bool {}
impl Send for f64 {}
impl Send for *const u8 {}
impl Send for *mut u8 {}
impl Send for String {}
impl Send for Bytes {}

impl Sync for i64 {}
impl Sync for usize {}
impl Sync for i32 {}
impl Sync for u32 {}
impl Sync for u16 {}
impl Sync for u8 {}
impl Sync for bool {}
impl Sync for f64 {}
impl Sync for String {}
impl Sync for Bytes {}

impl<T: Send> Send for Vec<T> {}
impl<T: Send> Send for Option<T> {}
impl<T: Sync> Sync for Vec<T> {}

// `umay_c_pthread_create` and `umay_c_pthread_join` are declared by
// `stdlib/platform/thread_<system>.um`, not here. The two operations and their
// success convention are the same everywhere; what starts a thread is not --
// POSIX has `pthread_create`, Windows has `CreateThread` and a handle to close.

// A running thread.
struct Thread {
    handle: *mut u8,
    joined: bool,
}

// Runs `work(value)` in a child process and returns the answer it left behind.
//
// The child is a `spawn`ed process rather than a thread: it gets its own copy of
// memory, so there is no shared mutable cell and nothing to lock. The value is
// carried in an argument and the answer comes back through a pipe, which is what
// makes both cross the boundary without a shared address.
//
// `A` and `R` are written by the caller because nothing else names them: by the
// time the value reaches the child it would be bytes. Naming them is what lets
// the language check that `A` may cross at all -- that is what `Send` is for.
//
// The answer must fit in eight bytes. A larger one is refused at compile time by
// `sizeof`, rather than being truncated to something that compiles.
fn thread_spawn<A: Send, R>(work: *const u8, value: A) -> R {
    if sizeof(R) > 8usize {
        panic("thread_spawn: the answer must fit in eight bytes")
    }
    // The hand-off is one value in and one answer out, and every system can do
    // that. How it is done differs: POSIX forks a child and reads the answer from
    // a pipe, Windows starts a thread and asks it for its exit value because
    // there is no `fork`. `umay_thread_spawn` picks between them, so this wrapper
    // holds no system-specific code.
    let answer = umay_thread_spawn(work, bits_of::<A>(value))
    return from_usize::<R>(answer)
}

// Reads a value's bits as the `usize` the thread entry receives.
//
// The reverse of `from_usize`, and only valid for a value that fits in eight
// bytes -- which the answer side has already established and which a `usize` value
// is by construction. Copying byte at a time is what makes this the exact inverse
// without asking the compiler to name a pointer to a type it has not seen.
fn bits_of<A>(value: A) -> usize {
    if sizeof(A) > 8usize {
        panic("thread_spawn: a value wider than eight bytes cannot cross")
    }
    let cell = alloc(8)
    let source = unsafe { &value as *const A as *const u8 }
    unsafe {
        let mut start = 0 as usize
        while start < sizeof(A) {
            write_byte(cell.offset(start as isize), read_byte(source.offset(start as isize)))
            start = start + 1 as usize
        }
    }
    let bits = umay_read_i64(cell) as usize
    dealloc(cell)
    return bits
}

// Reads a value's bits back into an `R`.
//
// Copying byte at a time is what makes this sound: anything larger than the
// channel would be read past its end.
fn from_usize<R>(bits: usize) -> R {
    let cell = alloc(sizeof(R))
    unsafe {
        let mut start = 0 as usize
        while start < sizeof(R) {
            write_byte(cell.offset(start as isize), read_byte((bits + start) as *const u8))
            start = start + 1 as usize
        }
        let out = *(cell as *const R)
        dealloc(cell)
        return out
    }
}

// Calls a function that takes one `usize` and returns a `usize`.
//
// A function value cannot be cast to a byte pointer yet, so the entry arrives as
// one and is called through this one place, where the cast is written once.
fn call_one(work: *const u8, value: usize) -> usize {
    unsafe {
        let f = work as *const fn(usize) -> usize
        return (*f)(value)
    }
}

// Starts a thread that runs `entry(arg)`.
//
// This is the unchecked form: the value is already a raw pointer, so its type is
// gone and nothing can say whether it may cross. `thread_spawn` above is the
// checked one and is the one to prefer.
//
// Reading the result is the price of a raw pointer: `arg` is an address the caller
// allocated, and the thread frees it only if the caller says so. That contract is
// the same one `fork` already has, and it is stated rather than hidden.
//
// Nothing is checked at this boundary. A check needs the type of the value being
// moved, and the value is a `*mut u8` by the time it arrives: the type is gone. A
// checked form would have to take the value itself and be generic over it, which
// needs turbofish to name the result type -- not yet supported. So `Send` is
// declared and implemented, and checked by nothing, which is what this comment
// says rather than what the marker's presence might suggest.
fn thread_start(entry: *const u8, arg: *mut u8) -> Thread {
    let handle = alloc(8)
    let ok = unsafe { umay_c_pthread_create(handle, 0usize as *const u8, entry, arg) }
    if ok != 0 {
        dealloc(handle)
        return Thread { handle: unsafe { 0usize as *mut u8 }, joined: false }
    }
    return Thread { handle: handle, joined: false }
}

// True when the thread was never started.
fn thread_failed(t: &Thread) -> bool {
    return unsafe { t.handle as usize } == 0usize
}

// Waits for the thread to finish.
fn thread_join(t: &mut Thread) -> bool {
    if t.joined || unsafe { t.handle as usize } == 0usize {
        return false
    }
    let result = alloc(8)
    let ok = unsafe { umay_c_pthread_join(t.handle, result as *mut *mut u8) }
    dealloc(result)
    t.joined = true
    return ok == 0
}
