// Reading and writing JSON, over counted bytes.
//
// The parser is a cursor into a `Bytes` rather than a tree: a value is read where
// it sits, and a caller that only wants one field never materialises the rest.
// That is what a request handler needs, and it keeps the whole library free of
// allocation except where it must copy a string out.
//
// Everything a value can be is `Json`, which owns nothing: a string is a `Bytes`
// into the document that was read.

// A JSON value, borrowing from the document it was parsed out of.
enum Json {
    Null,
    Bool(bool),
    Number(Bytes),
    Text(Bytes),
    Array(Bytes),
    Object(Bytes),
}

// Where the parser is: the document and the next byte to look at.
struct Cursor {
    at: usize,
    doc: Bytes,
}

impl Cursor {
    // A cursor at the first byte of `doc`.
    fn new(doc: Bytes) -> Cursor {
        return Cursor { at: 0usize, doc: doc }
    }

    // The byte under the cursor, or `0` at the end.
    fn peek(&self) -> u8 {
        return self.doc.get(self.at)
    }

    // True when nothing is left to read.
    fn at_end(&self) -> bool {
        return self.at >= self.doc.len
    }

    // Skips spaces, tabs, carriage returns and newlines.
    fn skip_space(&mut self) {
        while !self.at_end() {
            let c = self.doc.get(self.at)
            if c != 32u8 && c != 9u8 && c != 10u8 && c != 13u8 {
                return
            }
            self.at = self.at + 1
        }
    }
}

// Parses the document's first value, skipping surrounding whitespace.
//
// A malformed document yields `Json::Null` rather than a partially read value, so
// a caller can test `is_null()` once instead of checking every field. That is the
// honest shape here: there is no error value to return that a handler could act
// on differently, and a `Result` would only move the same check.
fn json_parse(doc: &Bytes) -> Json {
    let mut c = Cursor::new(*doc)
    c.skip_space()
    return json_value(&mut c)
}

// True for a value that could not be read.
fn json_is_missing(value: &Json) -> bool {
    return match value {
        Json::Null => true,
        _ => false,
    }
}

// Reads one value from the cursor.
fn json_value(c: &mut Cursor) -> Json {
    c.skip_space()
    if c.at_end() {
        return Json::Null
    }
    let ch = c.peek()
    if ch == 123u8 {
        return json_object(c)
    }
    if ch == 91u8 {
        return json_array(c)
    }
    if ch == 34u8 {
        return Json::Text(json_string(c))
    }
    if ch == 116u8 {
        // true
        c.at = c.at + 4
        return Json::Bool(true)
    }
    if ch == 102u8 {
        // false
        c.at = c.at + 5
        return Json::Bool(false)
    }
    if ch == 110u8 {
        // null
        c.at = c.at + 4
        return Json::Null
    }
    return Json::Number(json_number(c))
}

// Reads an object, returning a view of its body between the braces.
fn json_object(c: &mut Cursor) -> Json {
    let start = c.at + 1
    let end = matching_brace(c, 123u8, 125u8)
    return Json::Object(c.doc.range(start, end))
}

// Reads an array, returning a view of its body between the brackets.
fn json_array(c: &mut Cursor) -> Json {
    let start = c.at + 1
    let end = matching_brace(c, 91u8, 93u8)
    return Json::Array(c.doc.range(start, end))
}

// Finds the closing byte that balances the opener at the cursor, leaving the
// cursor just past it.
//
// Nesting is tracked by counting, and a quoted run is skipped whole so that a
// brace inside a string cannot unbalance the count.
fn matching_brace(c: &mut Cursor, open: u8, close: u8) -> usize {
    let mut depth: usize = 0
    let mut i = c.at
    while i < c.doc.len {
        let ch = c.doc.get(i)
        if ch == 34u8 {
            i = skip_quoted(c.doc, i)
            continue
        }
        if ch == open {
            depth = depth + 1
        } else if ch == close {
            depth = depth - 1
            if depth == 0 {
                c.at = i + 1
                return i
            }
        }
        i = i + 1
    }
    c.at = c.doc.len
    return c.doc.len
}

// The index just past the closing quote that matches the opening quote at `i`.
fn skip_quoted(doc: Bytes, i: usize) -> usize {
    let mut j = i + 1
    while j < doc.len {
        let ch = doc.get(j)
        if ch == 92u8 {
            j = j + 2
            continue
        }
        if ch == 34u8 {
            return j + 1
        }
        j = j + 1
    }
    return doc.len
}

// Reads a quoted string, returning its contents without the quotes.
//
// A byte after a backslash is taken as-is, so `\"` does not end the string. The
// escapes are not turned into the characters they stand for: a caller that needs
// that asks for it, and copying them out is the only case that would pay for it.
fn json_string(c: &mut Cursor) -> Bytes {
    let start = c.at + 1
    let end = skip_quoted(c.doc, c.at)
    c.at = end
    if end <= start {
        return Bytes::view(c.doc.data, 0usize)
    }
    return c.doc.range(start, end - 1)
}

// Reads a number, returning the text of it.
//
// The text is kept rather than converted, because a JSON number is decimal and a
// binary float is not: `0.1` has no exact float, and round-tripping it would make
// a server that echoes a field change the field. A caller that wants arithmetic
// converts with `json_number_as_i64` or its own parsing.
fn json_number(c: &mut Cursor) -> Bytes {
    let start = c.at
    let mut i = c.at
    while i < c.doc.len {
        let ch = c.doc.get(i)
        if (ch >= 48u8 && ch <= 57u8) || ch == 45u8 || ch == 43u8 || ch == 46u8 || ch == 101u8
            || ch == 69u8
        {
            i = i + 1
        } else {
            break
        }
    }
    c.at = i
    if i == start {
        return Bytes::view(c.doc.data, 0usize)
    }
    return c.doc.range(start, i)
}

// A number's integer value, truncating toward zero, or `0` when it is not one.
fn json_number_as_i64(text: Bytes) -> i64 {
    let mut i: usize = 0
    let mut negative = false
    if i < text.len && text.get(i) == 45u8 {
        negative = true
        i = i + 1
    }
    let mut n: i64 = 0
    while i < text.len {
        let ch = text.get(i)
        if ch < 48u8 || ch > 57u8 {
            break
        }
        n = n * 10i64 + (ch - 48u8) as i64
        i = i + 1
    }
    if negative {
        return -n
    }
    return n
}

// The number of decimal places in a number's text, which is what a fixed-point
// reader needs to place its divisor.
fn json_decimal_places(text: Bytes) -> i64 {
    let mut i: usize = 0
    while i < text.len {
        if text.get(i) == 46u8 {
            let mut count: i64 = 0
            let mut j = i + 1
            while j < text.len {
                let ch = text.get(j)
                if ch < 48u8 || ch > 57u8 {
                    break
                }
                count = count + 1
                j = j + 1
            }
            return count
        }
        i = i + 1
    }
    return 0i64
}

// The value stored under `key` in an object's body, or `Json::Null`.
//
// The search walks the body's members, comparing each key as bytes, and skips
// over nested values by counting braces so that a `key` inside a nested object is
// not mistaken for this one's.
fn json_get(object: &Bytes, key: &str) -> Json {
    let want = Bytes::from_str(key)
    let mut c = Cursor::new(*object)
    while !c.at_end() {
        c.skip_space()
        if c.at_end() {
            return Json::Null
        }
        if c.peek() == 44u8 {
            c.at = c.at + 1
            continue
        }
        if c.peek() != 34u8 {
            c.at = c.at + 1
            continue
        }
        let name = json_string(&mut c)
        c.skip_space()
        if c.peek() != 58u8 {
            return Json::Null
        }
        c.at = c.at + 1
        c.skip_space()
        if name.equals(&want) {
            return json_value(&mut c)
        }
        skip_value(&mut c)
    }
    return Json::Null
}

// The value stored under `key` in a document that is an object, or `Json::Null`.
fn json_field(doc: &Bytes, key: &str) -> Json {
    return match json_parse(doc) {
        Json::Object(body) => json_get(&body, key),
        _ => Json::Null,
    }
}

// The element at `index` in an array's body, or `Json::Null`.
fn json_at(array: &Bytes, index: usize) -> Json {
    let mut c = Cursor::new(*array)
    let mut n: usize = 0
    while !c.at_end() {
        c.skip_space()
        if c.at_end() {
            return Json::Null
        }
        if c.peek() == 44u8 {
            c.at = c.at + 1
            continue
        }
        if n == index {
            return json_value(&mut c)
        }
        skip_value(&mut c)
        n = n + 1
    }
    return Json::Null
}

// Moves the cursor past one value without reading it in detail.
fn skip_value(c: &mut Cursor) {
    c.skip_space()
    if c.at_end() {
        return
    }
    let ch = c.peek()
    if ch == 123u8 {
        matching_brace(c, 123u8, 125u8)
        return
    }
    if ch == 91u8 {
        matching_brace(c, 91u8, 93u8)
        return
    }
    if ch == 34u8 {
        json_string(c)
        return
    }
    let mut i = c.at
    while i < c.doc.len {
        let b = c.doc.get(i)
        if b == 44u8 || b == 125u8 || b == 93u8 || b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8 {
            break
        }
        i = i + 1
    }
    c.at = i
}

// The number of elements in an array's body.
fn json_count(array: &Bytes) -> usize {
    let mut c = Cursor::new(*array)
    let mut n: usize = 0
    while !c.at_end() {
        c.skip_space()
        if c.at_end() {
            return n
        }
        if c.peek() == 44u8 {
            c.at = c.at + 1
            continue
        }
        skip_value(&mut c)
        n = n + 1
    }
    return n
}

// The text of a string value, or an empty view for anything else.
fn json_text(value: Json) -> Bytes {
    return match value {
        Json::Text(text) => text,
        _ => Bytes::from_str(""),
    }
}

// The value's integer, or `0` for anything that is not a number or a bool.
fn json_i64(value: Json) -> i64 {
    return match value {
        Json::Number(text) => json_number_as_i64(text),
        Json::Bool(flag) => if flag { 1i64 } else { 0i64 },
        _ => 0i64,
    }
}

// The value's boolean, where a number means "not zero".
fn json_bool(value: Json) -> bool {
    return match value {
        Json::Bool(flag) => flag,
        Json::Number(text) => json_number_as_i64(text) != 0i64,
        _ => false,
    }
}

// A JSON string, quoted, in a buffer the caller supplies.
//
// The result borrows `out`: writing needs somewhere to put bytes, and a `String`
// grows by reallocation, so the caller says how much room it has. The return value
// is the number of bytes written, or `-1` when `out` was too small, which a caller
// checks once instead of at every byte.
fn json_quote(out: *mut u8, capacity: usize, text: Bytes) -> i64 {
    // A quote or a backslash in the text needs one more byte of room.
    let mut needed = text.len + 2
    let mut i: usize = 0
    while i < text.len {
        let ch = text.get(i)
        if ch == 34u8 || ch == 92u8 {
            needed = needed + 1
        }
        i = i + 1
    }
    if capacity < needed {
        return -1i64
    }
    unsafe {
        write_byte(out, 34u8)
    }
    let mut written: usize = 1
    i = 0
    while i < text.len {
        let ch = text.get(i)
        unsafe {
            if ch == 34u8 || ch == 92u8 {
                write_byte((out as usize + written) as *mut u8, 92u8)
                written = written + 1
            }
            write_byte((out as usize + written) as *mut u8, ch)
        }
        written = written + 1
        i = i + 1
    }
    unsafe {
        write_byte((out as usize + written) as *mut u8, 34u8)
    }
    return (written + 1) as i64
}

// A number as JSON text, in a buffer the caller supplies.
//
// The digits are written back to front and then reversed in place, which needs no
// temporary string and cannot lose a digit.
fn json_write_i64(out: *mut u8, capacity: usize, value: i64) -> i64 {
    let mut digits = [0u8; 24]
    let mut n = value
    let mut negative = false
    if n < 0i64 {
        negative = true
        // The most negative `i64` has no positive counterpart, so the digits are
        // taken from the magnitude without ever negating it.
        n = -n
    }
    let mut count: usize = 0
    if n == 0 {
        digits[0] = 48u8
        count = 1
    }
    while n > 0i64 {
        digits[count] = 48u8 + (n % 10i64) as u8
        n = n / 10i64
        count = count + 1
    }
    let total = count + if negative { 1 } else { 0 };
    if capacity < total {
        return -1i64
    }
    let mut i: usize = 0
    if negative {
        unsafe { write_byte(out, 45u8) }
        i = 1
    }
    while count > 0 {
        count = count - 1
        unsafe { write_byte((out as usize + i) as *mut u8, digits[count]) }
        i = i + 1
    }
    return total as i64
}
