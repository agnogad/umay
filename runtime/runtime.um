// UMAY runtime: the smallest layer that lets a program talk to the outside
// world.
//
// This file is ordinary UMAY source, compiled with every program rather than
// shipped as a binary blob, so a bug in it is a bug the compiler's own tools can
// find and a reader can follow.
//
// # The split between this file and a platform layer
//
// Everything below is portable: allocation, byte strings, integer formatting,
// output, error reporting. It is compiled identically for every target.
//
// What is *not* portable -- which C symbols exist, what their numeric constants
// mean, and whether a primitive exists at all -- lives in a platform layer that
// is concatenated *after* this file, in `runtime/platform/`:
//
//     linux.um     glibc, POSIX names, `fork`, `__errno_location`
//     macos.um     libSystem, POSIX names, `fork`, `__error`, its own O_* table
//     windows.um   MSVC CRT, underscored names, no `fork` (threads instead)
//
// The portable code reaches the platform through `umay_platform_*` functions
// and the `umay_c_*` bindings it declares. It never spells a C symbol name
// itself, so adding a system means adding a file over there rather than editing
// this one.
//
// # The C surface
//
// Only a handful of C functions are assumed: allocation, the descriptor I/O
// calls, and the platform's process primitives. Everything else -- length,
// printing, integer formatting -- is UMAY code. Keeping the C surface this small
// means every line that could be wrong is a line that can be read.
//
// There is no global state here on purpose: the language has no mutable
// statics yet, so the runtime must not need any. That is why output goes
// straight to file descriptors instead of through buffered C streams, which
// would have to be cached between calls.

// ---------------------------------------------------------------------------
// Constants that are the same everywhere
// ---------------------------------------------------------------------------

// The standard file descriptors. These are 0, 1 and 2 on every system the
// compiler targets, unlike the `open` flags, which are each system's own and
// therefore live in the platform layer.
const STDOUT: i32 = 1
const STDERR: i32 = 2

// --- allocation -------------------------------------------------------------

// Allocates `count` bytes, aborting rather than returning null.
//
// A null return from `malloc` means the program cannot continue, and carrying on
// would mean writing through a null pointer. Every allocation goes through here
// so that the check exists in exactly one place.
pub fn umay_alloc(count: usize) -> *mut u8 {
    let ptr = umay_c_malloc(count)
    if unsafe { ptr as usize } == 0 {
        umay_fail("umay: out of memory" as *const u8)
    }
    return ptr
}

pub fn umay_dealloc(ptr: *mut u8) {
    umay_c_free(ptr)
}

// --- raw memory -------------------------------------------------------------

// Reads one byte.
//
// The language has `*` for reading through a pointer, but no expression form
// that writes through one yet, so writing goes through these two functions. They
// exist so that the byte-at-a-time code in `byte_len` and the digit loop has a
// single, checkable place to go through.
pub fn umay_read_byte(ptr: *const u8) -> u8 {
    return unsafe { *ptr }
}

// Writes one byte. The caller owns `ptr` for the duration of the call.
pub fn umay_write_byte(ptr: *mut u8, value: u8) {
    unsafe { *ptr = value }
}

// Reads an `i64` from a raw address.
//
// A container stores values wider than a byte, and the language cannot yet write
// through a computed offset, so reading and writing a whole value goes through
// these two functions the same way bytes do.
pub fn umay_read_i64(ptr: *const u8) -> i64 {
    return unsafe { *(ptr as *const i64) }
}

// Writes an `i64` to a raw address.
pub fn umay_write_i64(ptr: *mut u8, value: i64) {
    unsafe { *(ptr as *mut i64) = value }
}

// Reads a `u16` from a raw address.
pub fn umay_read_u16(ptr: *const u8) -> u16 {
    return unsafe { *(ptr as *const u16) }
}

// Writes a `u16` to a raw address.
pub fn umay_write_u16(ptr: *mut u8, value: u16) {
    unsafe { *(ptr as *mut u16) = value }
}

// Reads a `u32` from a raw address.
pub fn umay_read_u32(ptr: *const u8) -> u32 {
    return unsafe { *(ptr as *const u32) }
}

// Writes a `u32` to a raw address.
pub fn umay_write_u32(ptr: *mut u8, value: u32) {
    unsafe { *(ptr as *mut u32) = value }
}

// --- file descriptors -------------------------------------------------------

// Opens `path` for reading and returns the descriptor, or -1.
pub fn umay_open_read(path: *const u8) -> i32 {
    return umay_c_open(path, umay_platform_open_flags(O_RDONLY), umay_platform_open_mode())
}

// Opens `path` for writing, creating or truncating it, and returns the descriptor,
// or -1.
pub fn umay_create(path: *const u8) -> i32 {
    return umay_c_open(
        path,
    umay_platform_open_flags(O_WRONLY | O_CREAT | O_TRUNC),
    umay_platform_open_mode(),
    )
}

// Opens `path` for appending, creating it if it does not exist, or -1.
pub fn umay_append(path: *const u8) -> i32 {
    return umay_c_open(
        path,
    umay_platform_open_flags(O_WRONLY | O_CREAT | O_APPEND),
    umay_platform_open_mode(),
    )
}

// Closes `fd` and returns 0, or -1.
pub fn umay_close(fd: i32) -> i32 {
    return umay_c_close(fd)
}

// Fills `buf` with up to `count` bytes from `fd`.
//
// Returns the number read, which is 0 at the end of the file and -1 on failure.
pub fn umay_read(fd: i32, buf: *mut u8, count: usize) -> isize {
    return umay_c_read(fd, buf, count)
}

// Writes `count` bytes to `fd`, retrying a short write.
//
// A write may accept fewer bytes than it is given; without the loop the rest
// would be lost and a file would end up truncated with no error reported.
pub fn umay_write(fd: i32, buf: *const u8, count: usize) -> isize {
    let mut done = 0 as usize
    while done < count {
        let left = count - done
        let chunk = umay_c_write(fd, unsafe { (buf as usize + done) as *const u8 }, left)
        if chunk < 0 {
            return -1
        }
        if chunk == 0 {
            return done as isize
        }
        done = done + chunk as usize
    }
    return done as isize
}

// Removes the file at `path`.
pub fn umay_unlink(path: *const u8) -> i32 {
    return umay_c_unlink(path)
}

// Renames a file.
//
// On Windows the CRT's `rename` refuses to replace an existing target where
// POSIX `rename` replaces it, so the platform layer provides the replacing form
// and this stays a single rule for every target.
pub fn umay_rename(from: *const u8, to: *const u8) -> i32 {
    return umay_platform_rename(from, to)
}

// Creates a directory.
//
// The mode argument is a POSIX concept; Windows' `_mkdir` takes none, so the
// platform layer supplies the call and the mode lives there.
pub fn umay_mkdir(path: *const u8) -> i32 {
    return umay_platform_mkdir(path)
}

// The size of a regular file in bytes, or -1 when it cannot be measured.
//
// This seeks to the end and back, so the cost does not depend on the file's size.
pub fn umay_file_size(path: *const u8) -> i64 {
    let fd = umay_open_read(path)
    if fd < 0 {
        return -1
    }
    let end = umay_c_lseek(fd, 0, 2)
    umay_c_close(fd)
    return end
}

// True when the path names a directory.
pub fn umay_is_dir(path: *const u8) -> bool {
    let fd = umay_open_read(path)
    if fd < 0 {
        return false
    }
    // A directory opens for reading on Linux but cannot be read from; the
    // descriptor is still usable, so the check is whether reading is refused.
    let scratch = umay_c_malloc(1)
    let refused = umay_c_read(fd, scratch, 1) < 0
    umay_c_free(scratch)
    umay_c_close(fd)
    return refused
}

// The value of an environment variable, or 0 when it is not set.
pub fn umay_getenv(name: *const u8) -> *const u8 {
    return umay_c_getenv(name)
}

// Ends the process with `code`.
pub fn umay_exit(code: i32) {
    umay_c_exit(code)
}

// The number the last failing call left in `errno`.
//
// `errno` is a macro in every C library, so there is no single symbol to call:
// glibc has `__errno_location`, Darwin has `__error`, and the MSVC CRT has
// `_errno`. The platform layer knows which one this target has, and this is the
// only portable spelling of the question.
pub fn umay_errno() -> i32 {
    return umay_platform_errno()
}

// --- byte strings -----------------------------------------------------------

// The number of bytes before the terminating zero.
//
// Three casts in this file are narrowing and the compiler warns about all three
// (W0102): `usize` to `isize` for `offset`, and `i64` to `u8` in
// `narrow_digit`. Each is exact by construction and cannot be proved so from the
// types, which is precisely what the warning says. They are listed here rather
// than silenced so that a reader can check the reasoning:
//
//   * `offset` takes `isize` because a negative offset must be expressible, and a
//     string is never longer than `isize::MAX`.
//   * `narrow_digit` is only ever called with `-(n % 10)`, which is in `0..=9`.
//
// `&str` is a NUL-terminated pointer, not a pointer-and-length pair, so the
// length is a scan. This is the price of passing strings to C for free, and it
// is paid once per print rather than once per string operation.
pub fn umay_byte_len(s: *const u8) -> usize {
    // `n` is declared at its final type rather than as a literal integer that is
    // converted on return: the literal would default to `i32`, and the conversion
    // back to `usize` would be a narrowing cast the compiler is right to warn
    // about.
    let mut n: usize = 0
    while unsafe { *s.offset(n as isize) } != 0u8 {
        n = n + 1
    }
    return n
}

// --- output -----------------------------------------------------------------

fn write_at(fd: i32, ptr: *const u8, count: usize) {
    if count == 0 {
        return
    }
    // The result is the number of bytes written; the runtime treats a short
    // write as final rather than retrying, which is good enough for a stream
    // that is normally a terminal or a file.
    let _ = umay_c_write(fd, ptr, count)
}

// Writes a byte string with no trailing newline.
pub fn umay_print(s: *const u8) {
    write_at(STDOUT, s, umay_byte_len(s))
}

// Writes a byte string followed by a newline.
pub fn umay_println(s: *const u8) {
    write_at(STDOUT, s, umay_byte_len(s))
    write_at(STDOUT, "\n" as *const u8, 1)
}

// Writes to standard error, for messages that must not be mixed into the
// program's real output.
pub fn umay_eprintln(s: *const u8) {
    write_at(STDERR, s, umay_byte_len(s))
    write_at(STDERR, "\n" as *const u8, 1)
}

// --- integers ---------------------------------------------------------------

// Writes a signed 64-bit integer in decimal, followed by a newline.
//
// The digits are produced from the least significant end into a local buffer and
// written in one call. The widest value, `-9223372036854775808`, needs twenty
// characters, so thirty-two bytes is enough.
pub fn umay_println_i64(value: i64) {
    let mut buf: [u8; 32] = [0u8; 32]
    // The digits are taken from an unsigned magnitude so that `i64::MIN`, whose
    // negation does not fit in an `i64`, is handled without a special case.
    let negative = value < 0
    // The magnitude is built digit by digit from the signed value, so nothing is
    // ever reinterpreted between signed and unsigned. Dividing on the negative
    // side keeps `i64::MIN` in range: its magnitude does not fit in an `i64`, but
    // its digits do.
    let mut signed = value
    let mut pos = 32usize
    if signed == 0 {
        pos = pos - 1
        buf[pos] = 48u8
    } else {
        while signed != 0 {
            // `%` and `/` keep the sign of the dividend, so `-(signed % 10)` is
            // always a digit in 0..=9.
            let digit = if negative { - (signed % 10) } else { signed % 10 }
            pos = pos - 1
            buf[pos] = 48u8 + narrow_digit(digit)
            signed = signed / 10
        }
        if negative {
            pos = pos - 1
            buf[pos] = 45u8
        }
    }
    // Only the digits from `pos` to the end were written; the bytes before it are
    // untouched padding.
    let start = ((&buf) as *const u8).offset(pos as isize)
    write_at(STDOUT, start, 32 - pos)
    write_at(STDOUT, "\n" as *const u8, 1)
}

// A digit is in 0..=9, so narrowing it is exact. The cast is written once here
// rather than at each call site, so there is one place to check.
//
// The compiler warns about this cast (W0102) because it cannot prove the range
// from the expression alone. The warning is correct in general and expected
// here: this function's only caller passes `-(n % 10)`.
fn narrow_digit(d: i64) -> u8 {
    return d as u8
}

// --- failures ---------------------------------------------------------------

// Prints a message to standard error and terminates the process.
//
// A failure cannot return: the program is in a state its checker did not prove
// reachable, so continuing would mean running with a broken invariant.
pub fn umay_fail(message: *const u8) {
    umay_eprintln(message)
    umay_c_exit(101)
}

// True when two NUL-terminated byte strings hold the same bytes.
//
// `str` is a pointer, so comparing two of them with `==` would compare
// addresses and call two equal strings different. This is the comparison the
// language promises, and it is what `==` on a `str` lowers to.
pub fn umay_str_eq(a: *const u8, b: *const u8) -> bool {
    unsafe {
        let mut i: usize = 0
        while true {
            let left = umay_read_byte((a as usize + i) as *const u8)
            let right = umay_read_byte((b as usize + i) as *const u8)
            if left != right {
                return false
            }
            if left == 0u8 {
                return true
            }
            i = i + 1
        }
    }
    return false
}

// The process id of a fresh child, which shares this address space until it
// writes to it, or `-1` when the system refuses.
//
// This is the whole of UMAY's concurrency today: a child has its own copy of
// every variable, so there is no shared mutable cell to race on, and a server
// gets its parallelism from one process per connection instead of a thread.
//
// Windows has no `fork`, so there this reports -1 and the fan-out below uses a
// thread instead. A program that calls `fork` itself through `process.um` gets
// -1 there, which is the honest answer rather than a child that will never
// exist.
pub fn umay_fork() -> i32 {
    return umay_platform_fork()
}

// Runs `work(value)` in a child process and returns what it answered.
//
// This is the checked fan-out's other half: the front end has already refused an
// `A` that does not carry `Send`, so by the time the call arrives the value is
// known to be safe to move. The child writes its answer to a pipe and the parent
// waits for it, which is the whole of the hand-off.
//
// Everything is eight bytes wide: `A` and `R` are checked against each other's
// size by the caller, and a wider type is refused rather than truncated.
pub fn umay_thread_spawn(work: *const u8, value: usize) -> usize {
    // Without `fork` the hand-off is a thread whose return value is the answer.
    // Both paths honour the same contract, which is what lets the caller be
    // written once: the value goes in, one answer comes back, nothing else is
    // shared.
    if !umay_platform_has_fork() {
        return umay_platform_thread_spawn(work, value)
    }
    // Sixteen bytes: two eight-byte ends. A POSIX descriptor would fit in four,
    // but a Windows handle would not, and one shape for both is what keeps this
    // body free of `#if`.
    let pipe = umay_alloc(16)
    if umay_pipe(pipe) != 0 {
        umay_dealloc(pipe)
        return 0
    }
    let read_end = umay_read_i64(pipe) as i32
    let write_end = umay_read_i64(unsafe { (pipe as usize + 8) as *const u8 }) as i32
    let pid = umay_c_fork()
    if pid == 0 {
        umay_c_close(read_end)
        let entry = work as *const fn(usize) -> usize
        let answer = unsafe { (*entry)(value) }
        let out = umay_alloc(8)
        umay_c_write_i64(out, answer as i64)
        let _ = umay_c_write(write_end, out, 8)
        umay_dealloc(out)
        umay_c_close(write_end)
        umay_c_exit(0)
    }
    umay_c_close(write_end)
    let gathered = umay_alloc(8)
    let got = umay_c_read(read_end, gathered, 8)
    umay_c_close(read_end)
    umay_dealloc(pipe)
    let status = umay_alloc(4)
    let _ = umay_c_waitpid(pid, status as *mut i32, 0)
    umay_dealloc(status)
    if got != 8 {
        umay_dealloc(gathered)
        return 0
    }
    let answer = umay_read_i64(gathered) as usize
    umay_dealloc(gathered)
    return answer
}

// Writes an `i64` to a raw address, for the thread hand-off.
fn umay_c_write_i64(ptr: *mut u8, value: i64) {
    umay_write_i64(ptr, value)
}

// Creates a pipe and writes its two ends into `fds`: the reading end first, then
// the writing end, eight bytes each. Returns 0, or -1 when the system refuses.
//
// Eight bytes rather than four because a POSIX descriptor and a Windows handle do
// not have the same width: the platform layer widens the narrow one so that this
// signature is the same everywhere.
pub fn umay_pipe(fds: *mut u8) -> i32 {
    return umay_c_pipe(fds)
}

// Waits for any child to finish and returns its id, or `-1`.
pub fn umay_waitpid(pid: i32, status: *mut i32, options: i32) -> i32 {
    return umay_c_waitpid(pid, status, options)
}

// Waits for `pid` to finish and returns the exit status it left.
//
// `waitpid` reports the status in a packed word -- the exit code is its second
// byte -- so a caller who wants the number the child returned goes through here
// rather than guessing at the packing.
pub fn umay_wait_exit(pid: i32) -> i32 {
    let status = umay_c_malloc(4)
    let got = umay_c_waitpid(pid, status as *mut i32, 0)
    if got < 0 {
        umay_c_free(status)
        return -1
    }
    let packed = umay_read_u32(status) as i32
    umay_c_free(status)
    // A process killed by a signal has no exit status; report the signal as a
    // negative number so the two cases cannot be confused for one another.
    let signal = packed & 0x7f
    if signal != 0 {
        return 0 - signal
    }
    return (packed >> 8) & 0xff
}
