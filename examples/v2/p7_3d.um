// Phase 7 3D slice: application body.
//
// Compiled by splicing three crate-root sources in this order (see
// compiler/tests/phase25_3d.rs):
//
//   1. `sdl_gen.um`  — byte-exact `umay bindgen` output from `sdl_min.h`
//   2. `math3d.um`   — frozen pure-UMAY integer 3D core / software renderer
//   3. this file     — the app
//
// The splice is deliberate: a declaration inside a module is private and
// codegen spells module items with `::`, which the assembler rejects. Splicing
// keeps the generated bytes unchanged, so this body has zero FFI declarations
// of its own and touches only the prelude.
//
// What it does: init SDL video, open a 64x64 window, clear an ARGB framebuffer,
// draw a rotating wireframe cube with `draw_cube`, blit the UMAY pixels through
// an SDL surface (the same present path as p7_sprite), and run a bounded
// fixed-timestep loop. `SDL_GetTicks()` deltas are accumulated into a total and
// averaged into a local `avg_ms`. In --selftest mode the reported average is a
// frame-count-derived sentinel so stdout is byte-exact; the default run reports
// the real measurement. In both modes the single line is
// `3D_OK <frames> <avg_ms_or_sentinel>`.
//
// Deferred: GPU/Vulkan renderer, z-buffer and triangle fill (the core is
// wireframe-only), text/fonts, audio, mouse and gamepad. See math3d.um for the
// fixed-point and projection model and every deliberate simplification.

// Zero `n` bytes at `buf`. Used for the event, frame and dummy buffers.
fn zero(buf: *mut u8, n: i64) {
    let mut i: i64 = 0
    while i < n {
        unsafe { write_byte((buf as usize + i as usize) as *mut u8, 0u8) }
        i = i + 1
    }
}

// Writes a non-negative integer as decimal ASCII into `out`, NUL-terminated,
// and returns the digit count (excluding the NUL).
fn put_dec(out: *mut u8, v: i64) -> usize {
    let mut digits = [0u8; 24]
    let mut count: usize = 0
    let mut n = v
    if n == 0 {
        digits[0] = 48u8
        count = 1
    } else {
        while n > 0 {
            digits[count] = 48u8 + (n % 10) as u8
            n = n / 10
            count = count + 1
        }
    }
    let mut at: usize = 0
    let mut i = count
    while i > 0 {
        i = i - 1
        unsafe { write_byte((out as usize + at) as *mut u8, digits[i]) }
        at = at + 1
    }
    unsafe { write_byte((out as usize + at) as *mut u8, 0u8) }
    return at
}

// The prelude has `println_i64` but no newline-free integer print, so assemble
// the pieces into one NUL-terminated buffer and print it once: stdout is
// exactly one line.
fn print_3d_ok(frames: i64, avg: i64) {
    let out = alloc(64usize)
    let prefix = "3D_OK " as *const u8
    let mut at: usize = 0
    let mut i: usize = 0
    while i < byte_len(prefix) {
        let c = unsafe { read_byte((prefix as usize + i) as *const u8) }
        unsafe { write_byte((out as usize + at) as *mut u8, c) }
        at = at + 1
        i = i + 1
    }
    at = at + put_dec(unsafe { (out as usize + at) as *mut u8 }, frames)
    unsafe { write_byte((out as usize + at) as *mut u8, 32u8) } // space
    at = at + 1
    at = at + put_dec(unsafe { (out as usize + at) as *mut u8 }, avg)
    unsafe { write_byte((out as usize + at) as *mut u8, 10u8) } // newline
    unsafe { write_byte((out as usize + at + 1) as *mut u8, 0u8) }
    print(out)
    dealloc(out)
}

fn main(argc: i32, argv: *mut *mut u8) -> i32 {
    let args = Args::new(argc, argv)
    let selftest = args.has_flag("--selftest" as *const u8)
    // Three frames in selftest so the dummy driver terminates quickly; 30 for
    // the default run. Both are bounded.
    let frames: i64 = if selftest { 3 } else { 30 }

    // --- SDL setup ---------------------------------------------------------
    let init_ok = unsafe { SDL_Init(0x20u64) } // SDL_INIT_VIDEO (SDL3) is Uint64
    if !init_ok {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    let window = unsafe { SDL_CreateWindow("umay 3d" as *const u8 as *const i8, 64, 64, 0u64) }
    if unsafe { window as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    let surface = unsafe { SDL_GetWindowSurface(window) }
    if unsafe { surface as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }

    // --- buffers ------------------------------------------------------------
    // 64x64 u32 ARGB8888 framebuffer the software renderer draws into.
    let fb_size: i64 = 64 * 64 * 4
    let fb = alloc(fb_size as usize)
    zero(fb, fb_size)

    // SDL_Event header: 128 zero bytes; SDL_EVENT_QUIT (0x100) sits at byte 0.
    let event = alloc(128usize)
    zero(event, 128)

    // --- bounded fixed-timestep loop ---------------------------------------
    let mut acc: i64 = 0          // pending ms for fixed steps (cadence only)
    let mut elapsed: i64 = 0      // total ms, used for the average below
    let mut last: i64 = unsafe { SDL_GetTicks() as i64 }
    let mut frame: i64 = 0
    while frame < frames {
        let now: i64 = unsafe { SDL_GetTicks() as i64 }
        let dt = now - last
        last = now
        elapsed = elapsed + dt
        acc = acc + dt
        // ponytail: consume whole 16ms steps but advance the picture once per
        // loop iteration; the rotation is a pure function of `frame`, so pixels
        // and stdout never depend on dummy-driver timing.
        while acc >= 16 { acc = acc - 16 }

        let pending = unsafe { SDL_PollEvent(event) }
        if pending {
            if unsafe { read_u32(event as *const u8) } == 0x100u32 {
                frame = frames
            }
        }

        zero(fb, fb_size)
        let rot = (frame * 2) % 16
        draw_cube(fb, 64, 64, rot)

        // Wrap the UMAY pixels as an SDL surface, blit it, then release it.
        let frame_surface = unsafe { SDL_CreateSurfaceFrom(64, 64, 0x16362004u32, fb, 256) }
        if unsafe { frame_surface as usize } != 0 {
            unsafe { SDL_BlitSurface(frame_surface, 0 as *const u8, surface, 0 as *const u8) }
            unsafe { SDL_DestroySurface(frame_surface) }
        }
        unsafe { SDL_UpdateWindowSurface(window) }
        unsafe { SDL_Delay(16u32) }

        frame = frame + 1
    }

    let avg_ms: i64 = if frames > 0 { elapsed / frames } else { 0 }
    // ponytail: SDL_GetTicks under the dummy driver is host-dependent, so the
    // selftest reports a frame-count-derived sentinel (frames - frames == 0)
    // instead of avg_ms. The real average is still computed and stored above.
    let reported: i64 = if selftest { frames - frames } else { avg_ms }
    print_3d_ok(frames, reported)

    dealloc(event)
    dealloc(fb)
    unsafe { SDL_DestroyWindow(window) }
    unsafe { SDL_Quit() }
    return 0
}
