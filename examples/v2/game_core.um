// Pure-UMAY game / mathematics core for Phase 7.
//
// Like `gui_core.um`, this file is SPLICED at crate root above a generated SDL
// binding and app body, so it must stay pure UMAY: no `extern`, no
// `#![feature]`, no `mod`, nothing outside the prelude. Everything here is
// integer math and raw-memory helpers built on `read_byte`/`write_u32` from
// `stdlib/prelude.um` — UMAY cannot write through a computed pointer offset, so
// every address is formed as `ptr as usize + byte_offset` and cast back.

// ponytail: integer-only Vec2. No floats (no stdlib math module exists) and
// packed fields keep Vec2 at 16 bytes.
struct Vec2 { x: i64, y: i64 }

// ponytail: hard-coded 8x8 sprite source. No image decoder, no sprite sheet,
// no audio — pixels arrive as a caller-owned ARGB8888 u32 buffer.
struct Sprite { pos: Vec2, vel: Vec2, w: i64, h: i64, pixels: *const u32 }

const SPRITE_W: i64 = 8
const SPRITE_H: i64 = 8

// Fills an 8x8 ARGB8888 pattern: two opaque colours alternating by pixel
// index (index 0 -> c0, 1 -> c1, 2 -> c0, ...). Writes 64 u32 = 256 bytes.
// A null buffer is a no-op.
fn make_sprite_pixels(buf: *mut u32) {
    if unsafe { buf as usize } == 0 { return }
    let c0: u32 = 0xffc85028u32
    let c1: u32 = 0xff284fc8u32
    let mut i: i64 = 0
    let total = SPRITE_W * SPRITE_H
    while i < total {
        let color: u32 = if (i % 2) == 0 { c0 } else { c1 }
        let at = unsafe { (buf as usize + (i * 4) as usize) as *mut u8 }
        write_u32(at, color)
        i = i + 1
    }
}

// Builds a sprite with zero velocity. The caller owns `pixels`.
fn sprite_new(x: i64, y: i64, w: i64, h: i64, pixels: *const u32) -> Sprite {
    let pos: Vec2 = Vec2 { x: x, y: y }
    let vel: Vec2 = Vec2 { x: 0, y: 0 }
    return Sprite { pos: pos, vel: vel, w: w, h: h, pixels: pixels }
}

// Reads an SDL keyboard-state array (SDL_scancode.h): LEFT=79, RIGHT=80,
// DOWN=81, UP=82. A pressed (nonzero) byte overwrites that axis' velocity.
// ponytail: no key-release zeroing — an unpressed axis keeps its velocity;
// callers wanting stopping behaviour must zero `vel` themselves.
fn sprite_input(s: &mut Sprite, keys: *const u8) {
    let base = unsafe { keys as usize }
    if base == 0 { return }
    let left = unsafe { read_byte((base + 79) as *const u8) }
    let right = unsafe { read_byte((base + 80) as *const u8) }
    let down = unsafe { read_byte((base + 81) as *const u8) }
    let up = unsafe { read_byte((base + 82) as *const u8) }
    if left != 0u8 { s.vel.x = -1 }
    if right != 0u8 { s.vel.x = 1 }
    if down != 0u8 { s.vel.y = 1 }
    if up != 0u8 { s.vel.y = -1 }
}

// Integrates velocity into position and clamps to 0..=56.
// ponytail: fixed bound 0..=56 = 64px field minus the 8px sprite; the frozen
// interface has no field-size parameter, so this bound is hard-coded. No
// collision detection.
fn sprite_step(s: &mut Sprite) {
    s.pos.x = s.pos.x + s.vel.x
    s.pos.y = s.pos.y + s.vel.y
    if s.pos.x < 0 { s.pos.x = 0 }
    if s.pos.x > 56 { s.pos.x = 56 }
    if s.pos.y < 0 { s.pos.y = 0 }
    if s.pos.y > 56 { s.pos.y = 56 }
}

// 1:1 blits the sprite's w*h ARGB pixels into a width*height framebuffer,
// clipping rows/columns outside the target. Source/destination addresses are
// built as `ptr as usize + byte_offset`; null buffers and non-positive sizes
// are no-ops. ponytail: no scaling, no alpha blending, no image decoder.
fn sprite_draw(s: &Sprite, buf: *mut u8, width: i64, height: i64) {
    let dst = unsafe { buf as usize }
    if dst == 0 { return }
    if width <= 0 || height <= 0 { return }
    let src = unsafe { s.pixels as usize }
    if src == 0 { return }
    let mut left = s.pos.x
    let mut top = s.pos.y
    let mut right = s.pos.x + s.w
    let mut bottom = s.pos.y + s.h
    if left < 0 { left = 0 }
    if top < 0 { top = 0 }
    if right > width { right = width }
    if bottom > height { bottom = height }
    if right < left || bottom < top { return }
    let mut row = top
    while row < bottom {
        let mut col = left
        while col < right {
            let sx = col - s.pos.x
            let sy = row - s.pos.y
            let src_off = ((sy * s.w + sx) as usize) * 4
            let from = unsafe { (src + src_off) as *const u8 }
            let color = read_u32(from)
            let to = unsafe { (dst + ((row * width + col) * 4) as usize) as *mut u8 }
            write_u32(to, color)
            col = col + 1
        }
        row = row + 1
    }
}

fn sprite_x(s: &Sprite) -> i64 {
    return s.pos.x
}

fn sprite_y(s: &Sprite) -> i64 {
    return s.pos.y
}

// Pure fixed-timestep accumulator: returns acc+dt, subtracting `step` until
// the remainder is below it. ponytail: step<=0 returns acc+dt unchanged so a
// bad step cannot hang the loop.
fn fixed_step(acc: i64, dt: i64, step: i64) -> i64 {
    if step <= 0 { return acc + dt }
    let mut a = acc + dt
    while a >= step { a = a - step }
    return a
}
