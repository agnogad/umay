// Phase 3 real-C spike: program body.
//
// This file is compiled by splicing the generated `sqlite_gen.um` (produced by
// `umay bindgen --header sqlite_min.h --out sqlite_gen.um`) directly above these
// lines into one crate-root `main.um`. The generated module is the ONLY source
// of C declarations here; nothing below is hand-written FFI.
//
// Why the splice instead of `mod sqlite_gen;`? A declaration inside a module is
// private to that module (E1018), and codegen spells a module item
// `sqlite_gen::sqlite3_open`, which the assembler rejects (`junk '::...'`).
// Both are compiler-side gaps; splicing keeps the generated bytes unchanged and
// needs no hand-written wrapper. See compiler/tests/phase18_sqlite_spike.rs.
//
// What it does: open an in-memory database, create a table and insert a row via
// one `sqlite3_exec`, print that call's status, close the database. The status
// is 0 (SQLITE_OK), so stdout is deterministic: "0".
fn main() -> i32 {
    let slot = alloc(8)
    // A string literal is `*const u8`; the C signature wants `*const i8`.
    let name = ":memory:" as *const u8 as *const i8
    let open_rc = unsafe { sqlite3_open(name, slot as *mut *mut u8) }
    let db = unsafe { read_i64(slot as *const u8) as usize as *mut u8 }
    // No callback: UMAY has no typed C-ABI callback here, so sqlite3_exec's
    // callback and arg are null. See docs/v2/ffi-spike.md §1.2 item 4.
    let sql = "CREATE TABLE t(x); INSERT INTO t VALUES(42);" as *const u8 as *const i8
    let rc = unsafe { sqlite3_exec(db, sql, 0 as *mut u8, 0 as *mut u8, 0 as *mut *mut i8) }
    unsafe { sqlite3_close(db) }
    println_i64(rc as i64)
    return open_rc
}
