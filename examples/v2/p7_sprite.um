// Phase 7 2D sprite demo: application body.
//
// Compiled by splicing three crate-root sources in this order (see
// compiler/tests/phase21_sprite_smoke.rs):
//
//   1. `sdl_gen.um`   — byte-exact `umay bindgen` output from `sdl_min.h`
//   2. `game_core.um` — frozen pure-UMAY sprite / input / math core
//   3. this file      — the app
//
// The splice is deliberate: a declaration inside a module is private and
// codegen spells module items with `::`, which the assembler rejects. Splicing
// keeps the generated bytes unchanged, so this body has zero FFI declarations
// of its own and touches only the prelude.
//
// What it does: init SDL video, open a 64x64 window, build an 8x8 ARGB sprite
// pattern, run a bounded fixed-timestep loop, and blit a UMAY-drawn u32
// framebuffer through an SDL surface. In --selftest mode a synthetic RIGHT+UP
// key buffer drives three steps and the single line `SPRITE_OK <x> <y>` is
// printed; the default run uses real keyboard state.
//
// Deferred: audio (no mixer binding), fonts/text (no rasteriser), image
// decoder (the sprite is a hand-built 8x8 ARGB pattern), GPU renderer (surface
// blit only), and floating-point / mouse motion (integer Vec2, keyboard only).

// Zero `n` bytes at `buf`. Used for the event, rect, key and frame buffers.
fn zero(buf: *mut u8, n: i64) {
    let mut i: i64 = 0
    while i < n {
        unsafe { write_byte((buf as usize + i as usize) as *mut u8, 0u8) }
        i = i + 1
    }
}

// Writes a non-negative integer as decimal ASCII into `out`, NUL-terminated,
// and returns the digit count (excluding the NUL).
fn put_dec(out: *mut u8, v: i64) -> usize {
    let mut digits = [0u8; 24]
    let mut count: usize = 0
    let mut n = v
    if n == 0 {
        digits[0] = 48u8
        count = 1
    } else {
        while n > 0 {
            digits[count] = 48u8 + (n % 10) as u8
            n = n / 10
            count = count + 1
        }
    }
    let mut at: usize = 0
    let mut i = count
    while i > 0 {
        i = i - 1
        unsafe { write_byte((out as usize + at) as *mut u8, digits[i]) }
        at = at + 1
    }
    unsafe { write_byte((out as usize + at) as *mut u8, 0u8) }
    return at
}

// The prelude has `println_i64` but no newline-free integer print, so assemble
// the three pieces into one NUL-terminated buffer and print it once: stdout is
// exactly one line, `SPRITE_OK <x> <y>\n`.
fn print_sprite_ok(x: i64, y: i64) {
    let out = alloc(64usize)
    let prefix = "SPRITE_OK " as *const u8
    let mut at: usize = 0
    let mut i: usize = 0
    while i < byte_len(prefix) {
        let c = unsafe { read_byte((prefix as usize + i) as *const u8) }
        unsafe { write_byte((out as usize + at) as *mut u8, c) }
        at = at + 1
        i = i + 1
    }
    at = at + put_dec(unsafe { (out as usize + at) as *mut u8 }, x)
    unsafe { write_byte((out as usize + at) as *mut u8, 32u8) } // space
    at = at + 1
    at = at + put_dec(unsafe { (out as usize + at) as *mut u8 }, y)
    unsafe { write_byte((out as usize + at) as *mut u8, 10u8) } // newline
    unsafe { write_byte((out as usize + at + 1) as *mut u8, 0u8) }
    print(out)
    dealloc(out)
}

fn main(argc: i32, argv: *mut *mut u8) -> i32 {
    let args = Args::new(argc, argv)
    let selftest = args.has_flag("--selftest" as *const u8)
    // Three synthetic RIGHT+UP steps move (0,8) -> (3,5); the default run is
    // capped so even the dummy driver terminates.
    let frames: i64 = if selftest { 3 } else { 60 }

    // --- SDL setup ---------------------------------------------------------
    let init_ok = unsafe { SDL_Init(0x20u64) } // SDL_INIT_VIDEO (SDL3) is Uint64
    if !init_ok {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    let window = unsafe { SDL_CreateWindow("umay sprite" as *const u8 as *const i8, 64, 64, 0u64) }
    if unsafe { window as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    let surface = unsafe { SDL_GetWindowSurface(window) }
    if unsafe { surface as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }

    // --- buffers ------------------------------------------------------------
    // 8x8 ARGB8888 source pattern, filled by the frozen core.
    let pix = alloc((8 * 8 * 4) as usize)
    make_sprite_pixels(unsafe { (pix as usize) as *mut u32 })

    // 64x64 u32 framebuffer the core draws into, cleared each frame.
    let fb_size: i64 = 64 * 64 * 4
    let fb = alloc(fb_size as usize)
    zero(fb, fb_size)

    // SDL_Event header: 128 zero bytes; SDL_EVENT_QUIT (0x100) sits at byte 0.
    let event = alloc(128usize)
    zero(event, 128)

    // SDL_Rect is 16 bytes. Reserved for sub-rect blits; this demo blits with
    // null rects, so it is only zeroed here (deferred feature).
    let rect = alloc(16usize)
    zero(rect, 16)

    // Real keyboard state (numkeys may be null). Selftest ignores it and uses
    // a synthetic RIGHT+UP buffer so stdout never depends on the host.
    let real_keys = unsafe { SDL_GetKeyboardState(0 as *mut i32) as *const u8 }
    let synth = alloc(128usize)
    zero(synth, 128)
    unsafe { write_byte((synth as usize + 80) as *mut u8, 1u8) } // SDL_SCANCODE_RIGHT
    unsafe { write_byte((synth as usize + 82) as *mut u8, 1u8) } // SDL_SCANCODE_UP
    let keys: *const u8 = if selftest { synth as *const u8 } else { real_keys }

    let mut sprite = sprite_new(0, 8, 8, 8, unsafe { (pix as usize) as *const u32 })

    // --- bounded fixed-timestep loop ---------------------------------------
    let mut acc: i64 = 0
    let mut last: i64 = unsafe { SDL_GetTicks() as i64 }
    let mut frame: i64 = 0
    while frame < frames {
        let now: i64 = unsafe { SDL_GetTicks() as i64 }
        acc = fixed_step(acc, now - last, 16)
        last = now

        let pending = unsafe { SDL_PollEvent(event) }
        if pending {
            if unsafe { read_u32(event as *const u8) } == 0x100u32 {
                frame = frames
            }
        }

        sprite_input(&mut sprite, keys)
        sprite_step(&mut sprite)

        zero(fb, fb_size)
        sprite_draw(&sprite, fb, 64, 64)

        // Wrap the UMAY pixels as an SDL surface, blit it, then release it.
        let frame_surface = unsafe { SDL_CreateSurfaceFrom(64, 64, 0x16362004u32, fb, 256) }
        if unsafe { frame_surface as usize } != 0 {
            unsafe { SDL_BlitSurface(frame_surface, 0 as *const u8, surface, 0 as *const u8) }
            unsafe { SDL_DestroySurface(frame_surface) }
        }
        unsafe { SDL_UpdateWindowSurface(window) }
        unsafe { SDL_Delay(16u32) }

        frame = frame + 1
    }

    print_sprite_ok(sprite_x(&sprite), sprite_y(&sprite))

    dealloc(synth)
    dealloc(rect)
    dealloc(event)
    dealloc(fb)
    dealloc(pix)
    unsafe { SDL_DestroyWindow(window) }
    unsafe { SDL_Quit() }
    return 0
}
