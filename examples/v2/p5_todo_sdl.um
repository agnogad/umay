// Phase 5 SDL3 first slice: application body.
//
// This is compiled by splicing two crate-root sources directly above these
// lines into one `main.um`, in this order:
//
//   1. `sdl_gen.um`   — generated by `umay bindgen --header sdl_min.h`, byte-exact
//   2. `gui_core.um`  — the frozen immediate-mode / todo model interface
//   3. this file      — the app
//
// The splice is deliberate. An FFI declaration inside `mod sdl_gen;` is
// private (E1018) and codegen spells it `sdl_gen::SDL_Init`, which the
// assembler rejects. Splicing keeps the generated bytes unchanged and means
// this body contains no hand-written FFI at all. See
// compiler/tests/phase20_sdl_smoke.rs.
//
// What it does: init SDL video, open a dummy-driver window, grab its surface,
// allocate an SDL_Event byte buffer (128 bytes) and an SDL_Rect byte buffer
// (16 bytes), then run a bounded frame loop. Each frame polls events, breaks
// on SDL_QUIT (0x100), fills a rect with a fixed ARGB8888 colour on the SDL
// surface, and also drives the immediate-mode path (gui_fill_rect / todo_draw) over a
// plain byte framebuffer. The todo model is mutated with add/toggle/delete and
// the final count is checked with todo_count. No text rendering or fonts.
//
// Output is deterministic so CI can assert it exactly: `GUI_OK 2`.
//
// NOTE: the UMAY prelude has no `read_i32` / `write_i32` (only i64/u16/u32
// variants), so this file defines local 32-bit helpers built on `read_u32`
// and `write_u32` rather than depending on a prelude change from another agent.

fn load_i32(p: *const u8, off: usize) -> i32 {
    let at = unsafe { (p as usize + off) as *const u8 }
    return read_u32(at) as i32
}

fn store_i32(p: *mut u8, off: usize, v: i32) {
    let at = unsafe { (p as usize + off) as *mut u8 }
    write_u32(at, v as u32)
}

// A capture-less function: it closes over nothing, so it is the shape a
// capture-less fn pointer would target. Kept as a plain fn so no `closures`
// feature attribute is needed next to the generated ABI feature one.
fn quit_requested(etype: i32) -> bool {
    return etype == 0x100
}

fn main(argc: i32, argv: *mut *mut u8) -> i32 {
    let args = Args::new(argc, argv)
    let selftest = args.has_flag("--selftest" as *const u8)
    let frames: i64 = if selftest { 4 } else { 8 }

    // --- SDL setup ---------------------------------------------------------
    let init_ok = unsafe { SDL_Init(0x20u64) } // SDL_INIT_VIDEO (SDL3) is Uint64
    if !init_ok {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    // Real SDL3 4-arg form: (title, w, h, Uint64 flags).
    let window = unsafe { SDL_CreateWindow("umay sdl" as *const u8 as *const i8, 64, 64, 0u64) }
    if unsafe { window as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }
    let surface = unsafe { SDL_GetWindowSurface(window) }
    if unsafe { surface as usize } == 0 {
        let err = unsafe { SDL_GetError() }
        panic(err as *const u8)
    }

    // SDL_Event is a union larger than 128 bytes on some targets; a zeroed
    // 128-byte buffer is enough for the common event header we read.
    let event = alloc(128)
    let mut z: usize = 0
    while z < 128 {
        write_byte(unsafe { (event as usize + z) as *mut u8 }, 0u8)
        z = z + 1
    }

    // SDL_Rect is { Sint32 x, y; Uint32 w, h; } — 16 bytes.
    let rect = alloc(16)
    store_i32(rect, 0, 0)
    store_i32(rect, 4, 0)
    store_i32(rect, 8, 16)
    store_i32(rect, 12, 16)

    // --- immediate-mode framebuffer (no SDL text/fonts) --------------------
    let width: i64 = 64
    let height: i64 = 32
    let fb = alloc((width * height) as usize)
    let mut p: usize = 0
    while p < (width * height) as usize {
        write_byte(unsafe { (fb as usize + p) as *mut u8 }, 0u8)
        p = p + 1
    }

    // --- todo model --------------------------------------------------------
    let mut items: Vec<TodoItem> = Vec::new()
    todo_add(&mut items, 1)
    todo_add(&mut items, 2)
    todo_add(&mut items, 3)
    todo_toggle(&mut items, 2)

    // --- bounded frame loop ------------------------------------------------
    let mut frame: i64 = 0
    while frame < frames {
        let pending = unsafe { SDL_PollEvent(event) }
        if pending {
            if quit_requested(load_i32(event, 0)) {
                frame = frames
            }
        }

        // SDL3's SDL_MapRGB needs a pixel-format struct the binder cannot
        // express, so use a fixed opaque ARGB8888 colour (A=255,R=200,G=80,B=40).
        // Its exact bytes do not affect the deterministic stdout assertion.
        let color: u32 = 0xffc85028u32
        unsafe { SDL_FillSurfaceRect(surface, rect, color) }

        gui_fill_rect(fb, width, 0, 0, width, height, 7u8)
        todo_draw(&items, fb, width, height)
        unsafe { SDL_UpdateWindowSurface(window) }
        unsafe { SDL_Delay(16u32) }

        frame = frame + 1
    }

    // --- mutate once more, then check the frozen interface -----------------
    todo_delete(&mut items, 1)
    let count = todo_count(&items)
    if count != 2 {
        panic("todo_count mismatch" as *const u8)
    }

    unsafe { SDL_DestroyWindow(window) }
    unsafe { SDL_Quit() }

    // Single deterministic line: `GUI_OK 2`.
    print("GUI_OK " as *const u8)
    println_i64(count)
    return 0
}
