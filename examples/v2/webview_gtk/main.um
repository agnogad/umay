// Phase 5/6 real-webview shell spike: application body.
//
// This file is compiled by splicing `gtk_gen.um` (produced by
// `umay bindgen --header gtk_min.h --out gtk_gen.um`) and `stdlib/ipc.um`
// directly above these lines into one crate-root `main.um`. The generated
// module is the ONLY source of C declarations here; nothing below is
// hand-written FFI. Splicing rather than a module keeps the generated bytes
// unchanged: a declaration inside `mod` is private (E1018) and codegen spells
// it with `::`, which the assembler rejects. See compiler/tests/phase25_webview.rs.
//
// What it does: initialise GTK3, build a window with a WebKit webview, load a
// data: URL, show everything, pump pending GTK events under a fixed cap (no
// callbacks and no gtk_main, which never returns), encode one IPC reply and
// print its JSON, then destroy the window and exit. stdout is the single line
// `{"id":7,"ok":true,"result":42}`; WebKit's diagnostics go to stderr.
//
// ponytail: the pump is bounded and callback-free, so the page never signals
// "load finished" and no JS <-> host bridge exists yet. Upgrade path: wire
// g_signal_connect / script-message-received once the callback ABI lands.

const WEBVIEW_MAX_PUMPS: usize = 512usize

fn main() -> i32 {
    // GTK3 accepts NULL argc/argv: no command-line plumbing is needed.
    unsafe { gtk_init(0 as *mut i32, 0 as *mut *mut *mut i8) }
    let window = unsafe { gtk_window_new(0i32) }
    let webview = unsafe { webkit_web_view_new() }
    unsafe { gtk_container_add(window, webview) }
    let url = "data:text/html,<h1>UMAY webview spike</h1>" as *const u8 as *const i8
    unsafe { webkit_web_view_load_uri(webview, url) }
    unsafe { gtk_widget_show_all(window) }
    let mut pumps: usize = 0usize
    while pumps < WEBVIEW_MAX_PUMPS {
        if unsafe { gtk_events_pending() } == 0 {
            break
        }
        unsafe { gtk_main_iteration() }
        pumps = pumps + 1usize
    }
    let out = alloc(256usize)
    let n = ipc_encode_reply(7i64, true, 42i64, out)
    println(out as *const u8)
    dealloc(out)
    unsafe { gtk_widget_destroy(window) }
    return 0i32
}
