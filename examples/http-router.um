// A routed HTTP server on port 8080, built on the stdlib router.
//
//     umay build examples/http-router.um && ./dist/http-router
//     curl localhost:8080/users/42
//
// Each handler fills in the response it is given. `serve` runs forever, one
// child process per connection; stop it with Ctrl-C.

fn home(_req: &Request, res: &mut Response) {
    *res = Response::new(200).with_type("text/plain").with_body(Bytes::from_str("home page\n"))
}

fn health(_req: &Request, res: &mut Response) {
    *res = Response::new(200).with_type("application/json").with_body(Bytes::from_str("{{\"ok\":true}}"))
}

// `:id` is whatever the second segment held.
fn user(req: &Request, res: &mut Response) {
    *res = Response::new(200).with_type("text/plain").with_body(req.param("id"))
}

// Echoes the posted body back.
fn echo(req: &Request, res: &mut Response) {
    *res = Response::new(201).with_type("text/plain").with_body(req.body())
}

fn main() -> i32 {
    let routes = [
        route("GET", "/", home),
        route("GET", "/api/health", health),
        route("GET", "/users/:id", user),
        route("POST", "/echo", echo),
    ]
    println("listening on 8080")
    return serve(8080u16, routes as *const Route, 4)
}
